<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        tools:targetApi="tiramisu" >
        <activity
            android:name=".WeekActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TutorialActivity"
            android:exported="false"
            android:label="@string/tutorial_title" />
        <activity
            android:name=".FirstActivity"
            android:exported="false"
            android:label="@string/title_activity_first" />

        <!--
            The form screens resize for the IME so that the action button
            pinned at the foot of the layout stays above the keyboard;
            BaseActivity folds the IME inset into their bottom padding.
        -->
        <activity
            android:name=".NewBudgetActivity"
            android:exported="false"
            android:label="@string/title_activity_new_budget"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".JoinBudgetActivity"
            android:exported="false"
            android:label="@string/title_activity_join_budget"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AddExpenseActivity"
            android:exported="false"
            android:label="@string/title_activity_add_expense"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MonthActivity"
            android:exported="false"
            android:label="@string/title_month" />

        <receiver
            android:name=".AddExpenseWidget"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/add_expense_widget_info" />
        </receiver>

        <activity
            android:name=".SwitchBudgetActivity"
            android:exported="false"
            android:label="@string/title_activity_switch_budget" />
        <activity
            android:name=".CategoryWeekActivity"
            android:exported="false"
            android:label="@string/title_categories" />
        <activity
            android:name=".CategoryMonthActivity"
            android:exported="false"
            android:label="@string/title_categories" />
        <activity
            android:name=".CategoryActivity"
            android:exported="false"
            android:label="@string/title_category" />
    </application>

</manifest>
