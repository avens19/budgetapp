<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        tools:targetApi="tiramisu" >
        <activity
            android:name=".WeekActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Invite links. autoVerify makes Android check
            /.well-known/assetlinks.json on the domain at install time and, when
            it matches, open this app instead of a browser — since Android 12 an
            unverified link never opens the app at all, so the fingerprint in that
            file has to be the certificate the installed app was actually signed
            with. With Play App Signing that is Play's, not the upload key's.

            Only /join/ is claimed. Every other page on that host is a web page
            and should stay one.
        -->
        <activity
            android:name=".InviteActivity"
            android:exported="true"
            android:label="@string/invite_joining"
            android:launchMode="singleTask">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="budget.andrewovens.com"
                    android:pathPrefix="/join/"
                    android:scheme="https" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TutorialActivity"
            android:exported="false"
            android:label="@string/tutorial_title" />
        <activity
            android:name=".FirstActivity"
            android:exported="false"
            android:label="@string/title_activity_first" />

        <!--
            The form screens resize for the IME so that the action button
            pinned at the foot of the layout stays above the keyboard;
            BaseActivity folds the IME inset into their bottom padding.
        -->
        <activity
            android:name=".NewBudgetActivity"
            android:exported="false"
            android:label="@string/title_activity_new_budget"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".JoinBudgetActivity"
            android:exported="false"
            android:label="@string/title_activity_join_budget"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AddExpenseActivity"
            android:exported="false"
            android:label="@string/title_activity_add_expense"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity
            android:name=".MonthActivity"
            android:exported="false"
            android:label="@string/title_month" />

        <receiver
            android:name=".AddExpenseWidget"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/add_expense_widget_info" />
        </receiver>

        <activity
            android:name=".SwitchBudgetActivity"
            android:exported="false"
            android:label="@string/title_activity_switch_budget" />
        <activity
            android:name=".CategoryWeekActivity"
            android:exported="false"
            android:label="@string/title_categories" />
        <activity
            android:name=".CategoryMonthActivity"
            android:exported="false"
            android:label="@string/title_categories" />
        <activity
            android:name=".CategoryActivity"
            android:exported="false"
            android:label="@string/title_category" />
    </application>

</manifest>
