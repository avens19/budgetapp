<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Budget.Card.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_xs">

        <ImageView
            android:id="@+id/category_dot"
            android:layout_width="@dimen/category_dot"
            android:layout_height="@dimen/category_dot"
            android:contentDescription="@null"
            android:src="@drawable/category_dot" />

        <TextView
            android:id="@+id/category_row_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="Groceries" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/category_menu"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_more_vert"
            app:iconPadding="0dp"
            app:iconSize="18dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
