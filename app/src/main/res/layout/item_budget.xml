<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Budget.Card.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_xs">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_m">

            <TextView
                android:id="@+id/budget_row_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Household" />

            <TextView
                android:id="@+id/budget_row_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="$450.00 a week" />
        </LinearLayout>

        <ImageView
            android:id="@+id/budget_row_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/budget_selected"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/budget_row_menu"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/space_xs"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_more_vert"
            app:iconPadding="0dp"
            app:iconSize="18dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
