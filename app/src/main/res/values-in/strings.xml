    <string name="apps_announcement_title">Anggaranmu kini ikut ke mana-mana</string>
    <string name="apps_announcement_body">Anggaran yang sama terbuka di iPhone — di sana namanya Weekly Spend, karena nama ini sudah dipakai — dan di budget.andrewovens.com lewat browser apa pun. Semuanya tetap sinkron, jadi kamu bisa mencatat pengeluaran di mana saja.</string>
    <string name="apps_announcement_dismiss">Nanti saja</string>
    <string name="error_no_browser">Tidak ada aplikasi di sini yang bisa membuka halaman web.</string>
