    <string name="invite_unusable_title">Undangan tidak berlaku</string>
    <string name="invite_unusable_body">Undangan ini sudah dipakai atau sudah kedaluwarsa. Satu undangan hanya berlaku sekali — minta yang baru dan pasti bisa.</string>
