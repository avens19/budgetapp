    <string name="planner_how_often">कितनी बार: %1$s</string>
    <string name="planner_group_income">आने वाला पैसा</string>
    <string name="planner_group_income_help">टैक्स और कटौतियों के बाद खाते में सचमुच जो आता है।</string>
    <string name="planner_group_fixed">वे बिल जो नहीं बदलते</string>
    <string name="planner_group_fixed_help">वे रकमें जो आपके सोचे बिना भी निकल जाती हैं। बचत भी यहीं आती है: जो पैसा आपने न खर्च करने का तय किया, वह खर्च का पैसा नहीं है।</string>
    <string name="planner_group_steady">नियमित खर्च (वैकल्पिक)</string>
    <string name="planner_group_steady_help">जो थोड़ा घटता-बढ़ता है पर कभी चौंकाता नहीं। इन्हें यहाँ घटा दें तो ये ऐप से बाहर रहेंगे; खाली छोड़ दें तो हफ्ते-दर-हफ्ते यहीं दर्ज करें। दोनों में से एक, दोनों नहीं।</string>
