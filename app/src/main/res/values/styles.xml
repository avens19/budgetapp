<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Money is the app's headline content, so it gets its own type ramp
        rather than borrowing the display styles. Tabular figures keep columns
        of amounts aligned; without them the proportional digits in Roboto
        make a right-aligned column look ragged.
    -->
    <style name="TextAppearance.Budget.Money.Hero" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Budget.Money.Row" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.Budget.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Cards -->

    <style name="Widget.Budget.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerMedium</item>
    </style>

    <!-- The one card per screen that carries the headline number. -->
    <style name="Widget.Budget.Card.Hero">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
    </style>

    <!-- Rows in a list: no fill, just a hairline, so long lists stay quiet. -->
    <style name="Widget.Budget.Card.Row" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
    </style>

    <!-- Controls -->

    <style name="Widget.Budget.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Material3.TitleLarge</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Widget.Budget.PeriodButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Budget.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="Widget.Budget.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- Full-width primary action at the bottom of a form. -->
    <style name="Widget.Budget.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleMedium</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
    </style>

    <style name="Widget.Budget.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleMedium</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
    </style>

    <style name="Widget.Budget.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!--
        The linear progress used for "spent against budget". Material 1.13
        defaults a bar to the expressive treatment: a gap before the track and
        a stop dot at the end. On a progress bar that represents "how much of
        the budget is gone" both read as data points that are not there, so
        they are turned off.
    -->
    <style name="Widget.Budget.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">10dp</item>
        <item name="trackCornerRadius">5dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

</resources>
