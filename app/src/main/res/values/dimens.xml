<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- A 4dp spacing scale; every layout picks from these rather than
         inventing one-off margins. -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">12dp</dimen>
    <dimen name="space_l">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_xxl">32dp</dimen>

    <!-- Screen gutter. values-w600dp widens it for tablets. -->
    <dimen name="screen_gutter">16dp</dimen>

    <!-- Leaves room for the extended FAB to float over the end of a list
         without covering the last row. -->
    <dimen name="list_bottom_inset">96dp</dimen>

    <!-- Carry balance's icon in compact mode, where the row is a single line. -->
    <dimen name="carry_icon_dense">15dp</dimen>

    <dimen name="card_elevation">0dp</dimen>
    <dimen name="category_dot">10dp</dimen>
    <dimen name="chart_size">260dp</dimen>

</resources>
