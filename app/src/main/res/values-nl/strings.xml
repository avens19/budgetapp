    <string name="invite_unusable_title">Uitnodiging ongeldig</string>
    <string name="invite_unusable_body">Deze uitnodiging is al gebruikt of verlopen. Een uitnodiging geldt één keer — vraag een nieuwe en het lukt wel.</string>
