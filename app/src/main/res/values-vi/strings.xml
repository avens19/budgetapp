    <string name="apps_announcement_title">Ngân sách giờ đi theo bạn</string>
    <string name="apps_announcement_body">Cùng một ngân sách mở được trên iPhone — ở đó tên là Weekly Spend, vì tên này đã có người dùng — và tại budget.andrewovens.com trên mọi trình duyệt. Mọi thứ luôn đồng bộ, nên bạn ở đâu cũng ghi được một khoản chi.</string>
